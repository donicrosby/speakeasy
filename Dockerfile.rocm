# syntax=docker/dockerfile:1

# Speakeasy — AMD ROCm variant (ROCm 10.1)
#
# Base: python:3.12-slim. No dedicated pytorch/ROCm container base is needed:
# AMD productized the entire ROCm 10.1 runtime as pip wheels on
# stable.repo.amd.com/rocm/whl-next/. `uv sync --extra rocm101` pulls
# torch[device-gfx1151] (2.14.0+rocm10.1.0), which drags in rocm[libraries],
# rocm-sdk-core/-libraries/-device-gfx1151, the amd-torch-device-gfx1151
# kernel shims, AMD's own triton build, and rocm-bootstrap (sets
# LD_LIBRARY_PATH at import). No apt ROCm repo, no skip-lists.
#
# The one thing no index provides: ctranslate2's ROCm wheel. PyPI only hosts
# the CUDA build, so the official CTranslate2 release asset
# (rocm-python-wheels-Linux.zip) is fetched and installed over the PyPI wheel.
# It is HIP-backed but still exposes device="cuda" — no app code changes.
# Its dynamic HIP linkage is satisfied by the pip-installed rocm-sdk-*
# libraries; the build-time import assert below fails loudly if not.
#
# gfx1151 (Strix Halo) kernels ship in the wheel via the device-gfx1151 extra;
# no HSA_OVERRIDE needed.
#
# Build:  docker build -f Dockerfile.rocm -t speakeasy:rocm .
# Run:    docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#                  --group-add render -p 8080:8080 speakeasy:rocm

FROM python:3.12-slim

ARG CT2_VERSION=4.8.2

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    SPEAKEASY_HF_HOME=/models \
    SPEAKEASY_PORT=8080 \
    SPEAKEASY_HOST=0.0.0.0

WORKDIR /app

# Locked dependency tree, ROCm 10.1 variant (torch + the pip ROCm runtime
# from the AMD index). --inexact so the later CT2 swap survives the final
# project sync without being pruned as extraneous.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra rocm101 --inexact

# Swap the PyPI (CUDA) ctranslate2 for the official ROCm wheel. Its HIP
# linkage resolves against the pip rocm-sdk-* libs installed above.
RUN set -eux; \
    apt-get update \
    && apt-get install -y --no-install-recommends curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*; \
    mkdir -p /tmp/ct2; \
    curl -fsSL -o /tmp/ct2/rocm-wheels.zip \
      "https://github.com/OpenNMT/CTranslate2/releases/download/v${CT2_VERSION}/rocm-python-wheels-Linux.zip"; \
    unzip -o -q /tmp/ct2/rocm-wheels.zip 'temp-linux/*cp312*x86_64*.whl' -d /tmp/ct2; \
    uv pip install --python /app/.venv/bin/python "$(ls /tmp/ct2/temp-linux/*cp312*x86_64*.whl)"; \
    rm -rf /tmp/ct2; \
    uv pip list --python /app/.venv/bin/python | grep -i '^ctranslate2 '

COPY src/ src/
RUN --mount=type=cache,sharing=locked,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra rocm101 --inexact

# Sanity: torch must be the HIP build and ctranslate2 must import (this is
# where a missing/broken ROCm runtime would surface at build time, loudly).
RUN /app/.venv/bin/python -c "import torch, ctranslate2, faster_whisper, speakeasy; assert torch.version.hip is not None, 'torch is not a ROCm/HIP build'; print('torch', torch.__version__, 'hip', torch.version.hip, '| ctranslate2', ctranslate2.__version__)"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=5 \
    CMD ["/app/.venv/bin/python", "-c", \
         "import urllib.request,sys; \
          sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=5).status == 200 else 1)"]

CMD ["/app/.venv/bin/speakeasy"]
