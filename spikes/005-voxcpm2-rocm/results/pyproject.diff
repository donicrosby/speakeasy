 # Explicit selection: ruff's "default" set includes opinionated rules that
@@ -117,6 +122,23 @@
 ignore = ["BLE001", "SIM115", "B008"]

 [tool.uv]
+# voxcpm's metadata pulls packages its runtime path never imports (gradio,
+# funasr, spaces), training-only ones (datasets, argbind), the denoiser's
+# modelscope, and torchcodec, which has no ROCm build and breaks
+# torchaudio.load for the whole process when present. An impossible marker
+# removes each from the resolution.
+override-dependencies = [
+    "torchcodec; sys_platform == 'never'",
+    "gradio; sys_platform == 'never'",
+    "gradio-client; sys_platform == 'never'",
+    "hf-gradio; sys_platform == 'never'",
+    "funasr; sys_platform == 'never'",
+    "spaces; sys_platform == 'never'",
+    "datasets; sys_platform == 'never'",
+    "argbind; sys_platform == 'never'",
+    "modelscope; sys_platform == 'never'",
+    "modelscope-hub; sys_platform == 'never'",
+]
 # The four accelerator extras are mutually exclusive by construction.
 #
 # ORDER IS LOAD-BEARING. uv turns this list into a decision tree in the order
