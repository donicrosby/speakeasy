# syntax=docker/dockerfile:1

# Speakeasy — NVIDIA CUDA variant
#
# Base: python:3.12-slim. The GPU torch stack comes from uv itself —
# `uv sync --extra cu130` pulls torch from download.pytorch.org/whl/cu130
# (declared in pyproject.toml as a conflicting-extra source). No nvidia-*
# skip-lists: the resolver picks the right wheels for the cu130 variant.
#
# ctranslate2 stays on the default PyPI wheel (bundles its own CUDA libs).
# torch's CUDA triton dependency resolves from PyPI (unpinned); only torch
# itself is index-routed to cu130.
#
# Build:  docker build -f Dockerfile.cuda -t speakeasy:cuda .
# Run:    docker run --gpus all -p 8080:8080 speakeasy:cuda

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    SPEAKEASY_HF_HOME=/models \
    SPEAKEASY_PORT=8080 \
    SPEAKEASY_HOST=0.0.0.0

WORKDIR /app

# Locked dependency tree, CUDA variant. Torch comes from the cu130 index via
# the extra; everything else from PyPI.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra cu130

COPY src/ src/
# Install the project itself (no deps to repeat — the first sync covered them).
RUN --mount=type=cache,sharing=locked,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra cu130

# Sanity: the torch in the venv must be a CUDA build.
RUN /app/.venv/bin/python -c "import torch; assert torch.cuda.is_available() or torch.version.cuda is not None, 'torch is not a CUDA build'; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

VOLUME /models

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=5 \
    CMD ["/app/.venv/bin/python", "-c", \
         "import urllib.request,sys; \
          sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=5).status == 200 else 1)"]

CMD ["/app/.venv/bin/speakeasy"]
